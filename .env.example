# ─── Database ──────────────────────────────────────────────
# Postgres connection string. `docker compose up -d` starts one matching this.
# If port 5432 is taken, set POSTGRES_PORT (used by docker-compose) and match it here.
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://jexi:jexi@localhost:5432/jexi"

# ─── App ───────────────────────────────────────────────────
# Public base URL, used for links inside emails.
APP_URL="http://localhost:3000"
# Secret for signing admin and customer session cookies. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ─── First admin account (created by `npm run db:seed`) ────
ADMIN_EMAIL="admin@jexi.store"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="JEXI Owner"

# ─── Email (Gmail SMTP) ────────────────────────────────────
# GMAIL_USER is the Gmail address that sends mail. GMAIL_APP_PASSWORD is a
# 16-character App Password (Google Account → Security → 2-Step Verification →
# App passwords). Your normal Gmail password will NOT work.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Optional "From" header. Defaults to "JEXI Accessories <GMAIL_USER>".
MAIL_FROM=""
# Where new-order alerts AND admin password-reset links go if no notification
# email is set in Admin → Settings.
ADMIN_NOTIFICATION_EMAIL=""

# Optional: use any other SMTP server instead of Gmail. When SMTP_HOST is set,
# these are used and the GMAIL_* values are the login credentials.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"

# ─── Uploads ───────────────────────────────────────────────
# Directory where admin image uploads are stored (served at /uploads/...).
UPLOAD_DIR="./uploads"
# Vercel Blob (added automatically on Vercel when a Blob store is connected).
# When set, admin image uploads go to Blob instead of UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=""
