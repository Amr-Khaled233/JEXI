// JEXI Accessories — data model
//
// Money convention: every monetary field is an Int in PIASTRES (1 EGP = 100).
// Use the helpers in src/lib/money.ts to convert and format.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────

enum ProductTag {
  BEST_SELLER
  NEW
  SALE
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AdminRole {
  OWNER
  STAFF
}

// ─── Catalog ───────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[] @relation("ProductCategories")
}

/// Colors a product can be offered in (managed from the dashboard).
model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  hex       String // "#d4af37"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  variants Variant[]
}

model Product {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  description    String       @default("")
  price          Int
  compareAtPrice Int?
  images         String[]
  tags           ProductTag[]
  published      Boolean      @default(false)
  soldCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  categories   Category[]    @relation("ProductCategories")
  variants     Variant[]
  giftBoxItems GiftBoxItem[]
  orderItems   OrderItem[]

  @@index([published, createdAt])
}

model Variant {
  id        String @id @default(cuid())
  productId String
  colorId   String
  stock     Int    @default(0)

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color        Color         @relation(fields: [colorId], references: [id], onDelete: Restrict)
  giftBoxItems GiftBoxItem[]
  orderItems   OrderItem[]

  @@unique([productId, colorId])
}

model GiftBox {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  coverImage  String
  price       Int
  published   Boolean  @default(false)
  soldCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items      GiftBoxItem[]
  orderItems OrderItem[]
}

model GiftBoxItem {
  id        String @id @default(cuid())
  giftBoxId String
  productId String
  variantId String
  quantity  Int    @default(1)

  giftBox GiftBox @relation(fields: [giftBoxId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

// ─── Promotions ────────────────────────────────────────────

model PromoCode {
  id               String       @id @default(cuid())
  code             String       @unique // stored uppercase
  description      String?
  discountType     DiscountType
  // PERCENTAGE: 1–100. FIXED: piastres.
  value            Int
  startsAt         DateTime
  endsAt           DateTime
  usageLimit       Int? // total redemptions; null = unlimited
  perCustomerLimit Int? // per email/phone; null = unlimited
  usedCount        Int          @default(0)
  minOrderValue    Int? // piastres
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  orders Order[]
}

// ─── Shipping ──────────────────────────────────────────────

model ShippingZone {
  id                String  @id @default(cuid())
  name              String  @unique // governorate name
  enabled           Boolean @default(true)
  fee               Int? // piastres; null = use the store default
  estimatedDelivery String? // e.g. "2–4 business days"
  sortOrder         Int     @default(0)
}

// ─── Orders ────────────────────────────────────────────────

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  // Random secret used in the confirmation link so order pages can't be enumerated.
  accessToken   String        @unique
  status        OrderStatus   @default(PENDING)
  customerName  String
  email         String
  phone         String
  governorate   String
  area          String
  address       String
  notes         String?
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Int
  discount      Int           @default(0)
  shippingFee   Int           @default(0)
  total         Int
  promoCodeId   String?
  promoCode     String? // snapshot of the code string
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  promo   PromoCode?           @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  giftBoxId String?
  // Snapshots so the order stays readable if the catalog changes.
  name      String
  colorName String?
  image     String?
  unitPrice Int
  quantity  Int
  lineTotal Int
  // Gift boxes: [{ name, color (name), quantity, productId, variantId }]
  contents  Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  giftBox GiftBox? @relation(fields: [giftBoxId], references: [id], onDelete: SetNull)
}

model OrderStatusHistory {
  id               String      @id @default(cuid())
  orderId          String
  status           OrderStatus
  note             String?
  notifiedCustomer Boolean     @default(false)
  createdAt        DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─── Admin & settings ──────────────────────────────────────

model AdminUser {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           AdminRole @default(STAFF)
  // Bumped on password change/reset; sessions signed with an older version are rejected.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())

  passwordResets AdminPasswordReset[]
}

model AdminPasswordReset {
  id        String    @id @default(cuid())
  adminId   String
  // SHA-256 of the token sent by email; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model StoreSettings {
  id                    Int       @id @default(1)
  storeName             String    @default("JEXI Accessories")
  tagline               String?   @default("Timeless pieces for every day")
  announcement          String?   @default("Free shipping across Egypt")
  contactEmail          String?
  contactPhone          String?
  whatsapp              String?
  instagram             String?
  facebook              String?
  tiktok                String?
  // Which social links appear in the footer.
  showInstagram         Boolean   @default(true)
  showFacebook          Boolean   @default(true)
  showTiktok            Boolean   @default(true)
  // New-order alerts go here (falls back to ADMIN_NOTIFICATION_EMAIL, then GMAIL_USER).
  notificationEmail     String?
  // Free-shipping offer: on/off, optional date window, optional minimum order.
  freeShippingEnabled   Boolean   @default(true)
  freeShippingStartsAt  DateTime?
  freeShippingEndsAt    DateTime?
  // piastres; when set, orders at or above it ship free even to zones with a fee.
  freeShippingThreshold Int?
  defaultTheme          String    @default("dark") // "dark" | "light" | "system"
  lowStockThreshold     Int       @default(3)
}

// Fixed-window rate-limit counters (shared across serverless instances).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// What the home page shows (single row, id = 1). Edited in Admin → Home Page.
model HomePage {
  id                 Int      @id @default(1)
  /// null = the JEXI brand photo
  heroImage          String?
  heroTagline        String   @default("Timeless pieces, made to be worn every day.")
  heroPrimaryLabel   String   @default("Shop the collection")
  heroPrimaryHref    String   @default("/shop")
  /// Empty label hides the second button.
  heroSecondaryLabel String   @default("Gift boxes")
  heroSecondaryHref  String   @default("/gift-boxes")
  showCategories     Boolean  @default(true)
  showBestSellers    Boolean  @default(true)
  bestSellersEyebrow String   @default("Most loved")
  bestSellersTitle   String   @default("Best Sellers")
  /// Chosen products in display order; empty = products tagged Best Seller.
  bestSellerIds      String[]
  showGiftBox        Boolean  @default(true)
  /// null = the best-selling published gift box
  featuredGiftBoxId  String?
  showNewArrivals    Boolean  @default(true)
  newArrivalsEyebrow String   @default("Just in")
  newArrivalsTitle   String   @default("New Arrivals")
  /// Chosen products in display order; empty = products tagged New.
  newArrivalIds      String[]
  showPromises       Boolean  @default(true)
  /// Individual items in the store promises strip.
  promiseShipping    Boolean  @default(true)
  promiseCod         Boolean  @default(true)
  promiseGift        Boolean  @default(true)
  promiseSupport     Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}
